{
  "schemaVersion": 2,
  "reset": {
    "weekday": "monday",
    "localTime": "00:00",
    "timeZone": "America/Chicago"
  },
  "metering": {
    "mode": "foreground-activity",
    "countPassiveViewing": true,
    "countBackgroundMedia": false,
    "pauseWhenLocked": true,
    "pauseWhenAsleep": true
  },
  "enforcement": {
    "websites": "browser-extension",
    "applications": "network-content-filter"
  },
  "api": {
    "bindAddress": "127.0.0.1",
    "port": 48123,
    "basePath": "/v1",
    "authentication": "scoped-bearer-token",
    "allowedBrowserOrigins": []
  },
  "children": [
    {
      "id": "child-one",
      "displayName": "Child 1 (example)",
      "macOSAccount": {
        "status": "needs-selection",
        "generatedUid": null
      }
    },
    {
      "id": "child-two",
      "displayName": "Child 2 (example)",
      "macOSAccount": {
        "status": "needs-selection",
        "generatedUid": null
      }
    }
  ],
  "applicationBindings": [
    {
      "id": "chesscom-macos",
      "displayName": "Chess.com macOS app",
      "status": "needs-selection",
      "identity": null
    },
    {
      "id": "chatgpt-macos",
      "displayName": "ChatGPT macOS app",
      "status": "needs-selection",
      "identity": null
    }
  ],
  "services": [
    {
      "id": "chesscom",
      "name": "Chess.com",
      "domains": [
        {
          "hostname": "chess.com",
          "includeSubdomains": true
        }
      ],
      "applicationIds": [
        "chesscom-macos"
      ]
    },
    {
      "id": "chatgpt",
      "name": "ChatGPT",
      "domains": [
        {
          "hostname": "chatgpt.com",
          "includeSubdomains": true
        }
      ],
      "applicationIds": [
        "chatgpt-macos"
      ]
    }
  ],
  "quotas": [
    {
      "id": "child-one-chesscom",
      "childId": "child-one",
      "serviceId": "chesscom",
      "weeklyLimitSeconds": 21600
    },
    {
      "id": "child-one-chatgpt",
      "childId": "child-one",
      "serviceId": "chatgpt",
      "weeklyLimitSeconds": 21600
    },
    {
      "id": "child-two-chesscom",
      "childId": "child-two",
      "serviceId": "chesscom",
      "weeklyLimitSeconds": 21600
    },
    {
      "id": "child-two-chatgpt",
      "childId": "child-two",
      "serviceId": "chatgpt",
      "weeklyLimitSeconds": 21600
    }
  ]
}
