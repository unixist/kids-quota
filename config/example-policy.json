{
  "schemaVersion": 1,
  "reset": {
    "weekday": "monday",
    "localTime": "00:00",
    "timeZone": "America/Chicago"
  },
  "metering": {
    "mode": "foreground-activity",
    "countPassiveViewing": true,
    "countBackgroundMedia": false,
    "pauseWhenLocked": true,
    "pauseWhenAsleep": true
  },
  "enforcement": {
    "websites": "browser-extension",
    "applications": "network-content-filter"
  },
  "applicationBindings": [
    {
      "id": "chesscom-macos",
      "displayName": "Chess.com macOS app",
      "status": "needs-selection",
      "identity": null
    },
    {
      "id": "chatgpt-macos",
      "displayName": "ChatGPT macOS app",
      "status": "needs-selection",
      "identity": null
    }
  ],
  "quotas": [
    {
      "id": "chesscom",
      "name": "Chess.com",
      "hoursPerWeek": 6,
      "domains": [
        { "hostname": "chess.com", "includeSubdomains": true }
      ],
      "applicationIds": ["chesscom-macos"]
    },
    {
      "id": "chatgpt",
      "name": "ChatGPT",
      "hoursPerWeek": 6,
      "domains": [
        { "hostname": "chatgpt.com", "includeSubdomains": true }
      ],
      "applicationIds": ["chatgpt-macos"]
    }
  ]
}
